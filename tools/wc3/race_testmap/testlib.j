// ===== RACE TEST LIBRARY (generic, generated by tools/race_testmap) =====
function RT_Time takes nothing returns string
    local integer s = R2I(TimerGetElapsed(gRTClock))
    local string m = I2S(s / 60)
    local string r = I2S(ModuloInteger(s, 60))
    if StringLength(r) < 2 then
        set r = "0" + r
    endif
    return "[" + m + ":" + r + "]"
endfunction

function RT_Log takes string s returns nothing
    // parallel_lanes: lane column right after the time ("L1".."Ln", "--" = no lane)
    if gAct >= 0 then
        call Preload(RT_Time() + " L" + I2S(gAct + 1) + " " + s)
    else
        call Preload(RT_Time() + " -- " + s)
    endif
    set gRTLines = gRTLines + 1
endfunction

function RT_Flush takes nothing returns nothing
    call PreloadGenEnd(RT_FILE)
endfunction

function RT_Say takes string s, real d returns nothing
    call DisplayTimedTextToPlayer(Player(0), 0.0, 0.0, d, s)
endfunction

// parallel_lanes: announcements of a test only for the lane the camera follows (results are always shown, with the lane)
function RT_SayL takes string s, real d returns nothing
    if gAct == gCamLane then
        call RT_Say(s, d)
    endif
endfunction

function RT_CamName takes nothing returns string
    if gCamLane < 0 then
        return "free"
    endif
    return "lane " + I2S(gCamLane + 1)
endfunction

// lane whose arena contains the point (-1 = none); arenas are disjoint (checked statically by gen_testmap.py)
function RT_LaneAt takes real x, real y returns integer
    local integer l = 0
    loop
        exitwhen l >= RT_NL
        if x >= gLX0[l] and x <= gLX1[l] and y >= gLY0[l] and y <= gLY1[l] then
            return l
        endif
        set l = l + 1
    endloop
    return -1
endfunction

function RT_UnitLane takes unit u returns integer
    if u == null then
        return -1
    endif
    return RT_LaneAt(GetUnitX(u), GetUnitY(u))
endfunction

// context switch: the single-test globals of the driver are swapped per lane (RT_Save/RT_Load are generated)
function RT_Enter takes integer l returns integer
    local integer p = gAct
    if p == l then
        return p
    endif
    if p >= 0 then
        call RT_Save(p)
    endif
    call RT_Load(l)
    set gAct = l
    return p
endfunction

function RT_Leave takes integer l, integer p returns nothing
    if p == l then
        return
    endif
    call RT_Save(l)
    set gAct = p
    if p >= 0 then
        call RT_Load(p)
    endif
endfunction

function RT_JobDone takes integer l returns nothing
    local integer j = gLJob[l]
    set gJState[j] = 2
    set gLBusy[l] = false
    set gLBusyT[l] = gLBusyT[l] + TimerGetElapsed(gRTClock) - gLT0[l]
    call RT_Log("LANE_END lane " + I2S(l + 1) + " t=" + R2SW(TimerGetElapsed(gRTClock), 1, 1) + " job " + I2S(j + 1) + " took " + R2SW(TimerGetElapsed(gRTClock) - gLT0[l], 1, 1) + " s")
    if gExclLane == l then
        set gExclLane = -1
    endif
    if gSelLane == l then
        set gSelLane = -1
    endif
    set gCur = gTN
    set gStage = 0
endfunction

function RT_Id takes integer i returns string
    local string c = "0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz"
    local string r = ""
    local integer k = 0
    local integer v
    if i == 0 then
        return "0"
    endif
    loop
        exitwhen k >= 4
        set v = ModuloInteger(i, 256) - 48
        if v >= 0 and v < StringLength(c) then
            set r = SubString(c, v, v + 1) + r
        else
            set r = "?" + r
        endif
        set i = i / 256
        set k = k + 1
    endloop
    return r
endfunction

function RT_B takes boolean b returns string
    if b then
        return "true"
    endif
    return "false"
endfunction

function RT_ReqState takes integer i returns string
    local integer k = 0
    local integer r
    local string s = ""
    loop
        exitwhen k >= 4
        set r = gTReqId[i * 4 + k]
        if r != 0 then
            set s = s + RT_Id(r) + "=" + I2S(GetPlayerTechCount(gRTP, r, true)) + " "
        endif
        set k = k + 1
    endloop
    return s
endfunction

function RT_Ok takes unit u returns boolean
    return u != null and GetUnitTypeId(u) != 0 and not IsUnitType(u, UNIT_TYPE_DEAD)
endfunction

function RT_Hold takes unit u returns nothing
    call SetUnitAcquireRange(u, 0.0)
    call IssueImmediateOrder(u, "holdposition")
endfunction

// explicit_facing isolation: every placed unit starts QUIET (no acquisition, weapons off). Only units given an explicit order (RT_Act) or the caster
// in attack-based modes may attack. Damage from any other placed unit is blocked and logged as CONTAMINATED.
function RT_Quiet takes unit u, boolean quiet returns nothing
    if u == null then
        return
    endif
    call BlzSetUnitWeaponBooleanField(u, UNIT_WEAPON_BF_ATTACKS_ENABLED, 0, not quiet)
    call BlzSetUnitWeaponBooleanField(u, UNIT_WEAPON_BF_ATTACKS_ENABLED, 1, not quiet)
    if quiet then
        call SetUnitAcquireRange(u, 0.0)
    endif
endfunction

function RT_Act takes unit u returns unit
    if u != null then
        call GroupAddUnit(gRTAct, u)
        call RT_Quiet(u, false)
    endif
    return u
endfunction

// clean_target_dummies: stock target dummies must be ability-free (no Slow/Defend/Invisibility/Polymorph etc. contaminating metrics)
function RT_KeepAbil takes integer a returns boolean
    return a == 'Aatk' or a == 'Amov' or a == 'Apiv' or a == 'Aloc' or a == 'Avul' or a == 'AInv' or a == 'Abdt' or a == 'BTLF'
endfunction

function RT_IsDummy takes integer id returns boolean
    return id == 'hfoo' or id == 'hgry' or id == 'hsor' or id == 'osw1'
endfunction

// returns the number of non-whitelisted abilities left (0 = clean)
function RT_Extra takes unit u, boolean remove returns integer
    local integer k = 0
    local integer n = 0
    local integer guard = 0
    local integer a
    local ability ab
    loop
        set ab = BlzGetUnitAbilityByIndex(u, k)
        exitwhen ab == null or guard > 40
        set guard = guard + 1
        set a = BlzGetAbilityId(ab)
        if RT_KeepAbil(a) or (a / 16777216) == 66 then
            set k = k + 1
        elseif remove and UnitRemoveAbility(u, a) then
            call RT_Log("  DIAG dummy " + RT_Id(GetUnitTypeId(u)) + ": removed ability " + RT_Id(a))
        else
            set n = n + 1
            set k = k + 1
        endif
    endloop
    set ab = null
    return n
endfunction

function RT_AbilList takes unit u returns string
    local integer k = 0
    local string s = ""
    local ability ab
    loop
        set ab = BlzGetUnitAbilityByIndex(u, k)
        exitwhen ab == null or k > 40
        if not RT_KeepAbil(BlzGetAbilityId(ab)) then
            set s = s + RT_Id(BlzGetAbilityId(ab)) + " "
        endif
        set k = k + 1
    endloop
    set ab = null
    return s
endfunction

function RT_New takes player p, integer id, real x, real y, real f returns unit
    local unit u = CreateUnit(p, id, x, y, f)
    if u != null then
        call GroupAddUnit(gRTAll, u)
        call RT_Quiet(u, true)
        if RT_IsDummy(id) then
            call RT_Extra(u, true)
            call GroupAddUnit(gRTDummy, u)
            // current_ability_level_b: no natural regeneration on test dummies (regen was measured as an "effect" in mana/life tests)
            call BlzSetUnitRealField(u, UNIT_RF_HIT_POINTS_REGENERATION_RATE, 0.0)
            call BlzSetUnitRealField(u, UNIT_RF_MANA_REGENERATION, 0.0)
        endif
        if p == gRTP then
            call RT_Register(u)
        endif
    endif
    set gRTLast = u
    set u = null
    return gRTLast
endfunction

function RT_CleanAll takes nothing returns nothing
    if not IsUnitInGroup(GetEnumUnit(), gRTBase) then
        call RemoveUnit(GetEnumUnit())
    endif
endfunction

function RT_Clean takes nothing returns nothing
    local unit u
    call ForGroup(gRTAll, function RT_CleanAll)
    call GroupClear(gRTDummy)
    if gRTTimeSet then
        call SetTimeOfDay(12.0)
        set gRTTimeSet = false
    endif
    if gRTFogOff then
        call FogEnable(false)
        call FogMaskEnable(false)
        call FogModifierStart(gRTFogAll)
        call SetPlayerAlliance(Player(0), gRTP, ALLIANCE_SHARED_VISION, true)
        set gRTFogOff = false
    endif
    call GroupEnumUnitsInRange(gRTTmp, gRTX, gRTY, 1100.0, null)
    loop
        set u = FirstOfGroup(gRTTmp)
        exitwhen u == null
        call GroupRemoveUnit(gRTTmp, u)
        if not IsUnitInGroup(u, gRTBase) and GetOwningPlayer(u) != Player(PLAYER_NEUTRAL_PASSIVE) then
            call RemoveUnit(u)
        endif
    endloop
    call GroupClear(gRTAll)
    call GroupClear(gRTAct)
    set gRTContam = false
    set gRTK = 0
    loop
        exitwhen gRTK >= 10
        if gRTTree[gLT + gRTK] != null then
            call RemoveDestructable(gRTTree[gLT + gRTK])
            set gRTTree[gLT + gRTK] = null
        endif
        set gRTK = gRTK + 1
    endloop
    set gRTCaster = null
    set gRTE1 = null
    set gRTE2 = null
    set gRTE3 = null
    set gRTInv = null
    set gRTA1 = null
    set gRTA2 = null
    set gRTB = null
    set gRTMine = null
    set gRTTrained = null
    set u = null
endfunction

// ---- measurement
function RT_Buffs takes unit u returns integer
    local integer k = 0
    local integer n = 0
    local integer a
    local ability ab
    if not RT_Ok(u) then
        return 0
    endif
    // current_ability_level_b: UnitCountBuffsEx filter flags are AND-combined (magic AND physical AND timed life AND aura) -> it returned 0 for
    // ordinary buffs. Buffs are abilities on the unit whose rawcode starts with 'B': count those instead (timed life excluded).
    loop
        set ab = BlzGetUnitAbilityByIndex(u, k)
        exitwhen ab == null or k > 60
        set a = BlzGetAbilityId(ab)
        if a / 16777216 == 66 and a != 'BTLF' then
            set n = n + 1
        endif
        set k = k + 1
    endloop
    set ab = null
    return n
endfunction

function RT_Snap takes integer k returns nothing
    local unit u
    local real el = 0.0
    local real em = 0.0
    local real es = 0.0
    local real ea = 0.0
    local integer eb = 0
    local real al = 0.0
    local real am = 0.0
    local real aa = 0.0
    local integer ab = 0
    local integer n = 0
    local integer ld = 0
    local integer hid = 0
    call GroupEnumUnitsInRange(gRTTmp, gRTX, gRTY, 1100.0, null)
    loop
        set u = FirstOfGroup(gRTTmp)
        exitwhen u == null
        call GroupRemoveUnit(gRTTmp, u)
        if not IsUnitType(u, UNIT_TYPE_DEAD) and not IsUnitInGroup(u, gRTBase) then
            set n = n + 1
            if GetOwningPlayer(u) == gRTEP then
                set el = el + GetWidgetLife(u)
                set em = em + GetUnitState(u, UNIT_STATE_MANA)
                set es = es + GetUnitMoveSpeed(u)
                set ea = ea + BlzGetUnitArmor(u)
                set eb = eb + RT_Buffs(u)
            elseif GetOwningPlayer(u) == gRTP and u != gRTCaster then
                set al = al + GetWidgetLife(u)
                set am = am + GetUnitState(u, UNIT_STATE_MANA)
                set aa = aa + BlzGetUnitArmor(u)
                set ab = ab + RT_Buffs(u)
                if IsUnitLoaded(u) then
                    set ld = ld + 1
                endif
            endif
            if GetOwningPlayer(u) == gRTP and u != gRTCaster and not IsUnitVisible(u, gRTEP) then
                set hid = hid + 1
            endif
        endif
    endloop
    // lane_players: GroupEnumUnitsInRange skips HIDDEN units (ShowUnit false: shelters, burrows) -> count them from the test's own unit group
    call GroupAddGroup(gRTAll, gRTTmp)
    loop
        set u = FirstOfGroup(gRTTmp)
        exitwhen u == null
        call GroupRemoveUnit(gRTTmp, u)
        if IsUnitHidden(u) and GetOwningPlayer(u) == gRTP and u != gRTCaster and not IsUnitType(u, UNIT_TYPE_DEAD) and not IsUnitInGroup(u, gRTBase) then
            set hid = hid + 1
        endif
    endloop
    if RT_Ok(gRTCaster) and IsUnitType(gRTCaster, UNIT_TYPE_HERO) == false then
        set aa = aa + BlzGetUnitArmor(gRTCaster)
    endif
    set gV[gLO + k * 32 + 0] = el
    set gV[gLO + k * 32 + 1] = al
    set gV[gLO + k * 32 + 2] = em
    set gV[gLO + k * 32 + 3] = es
    set gV[gLO + k * 32 + 4] = I2R(n)
    set gV[gLO + k * 32 + 5] = aa
    set gV[gLO + k * 32 + 6] = ea
    set gV[gLO + k * 32 + 7] = I2R(eb)
    set gV[gLO + k * 32 + 8] = I2R(ab)
    set gV[gLO + k * 32 + 9] = am
    set gV[gLO + k * 32 + 10] = I2R(ld)
    set gV[gLO + k * 32 + 11] = I2R(hid)
    set gV[gLO + k * 32 + 12] = I2R(GetPlayerState(gRTP, PLAYER_STATE_RESOURCE_GOLD))
    set gV[gLO + k * 32 + 13] = I2R(GetPlayerState(gRTP, PLAYER_STATE_RESOURCE_LUMBER))
    if RT_Ok(gRTCaster) then
        set gV[gLO + k * 32 + 14] = GetUnitX(gRTCaster)
        set gV[gLO + k * 32 + 15] = GetUnitY(gRTCaster)
        set gV[gLO + k * 32 + 16] = I2R(ModuloInteger(GetUnitTypeId(gRTCaster), 16777216))  // lane_players: full rawcodes lose their low bits in a real
        set gV[gLO + k * 32 + 17] = I2R(BlzGetUnitMaxHP(gRTCaster))
    endif
    if RT_Ok(gRTE1) then
        set gV[gLO + k * 32 + 18] = GetUnitX(gRTE1)
        set gV[gLO + k * 32 + 19] = GetUnitY(gRTE1)
    endif
    if RT_Ok(gRTCaster) and not IsUnitVisible(gRTCaster, gRTEP) then
        set gV[gLO + k * 32 + 30] = 1.0
    else
        set gV[gLO + k * 32 + 30] = 0.0
    endif
    if RT_Ok(gRTInv) then
        if IsUnitVisible(gRTInv, gRTP) then
            set gV[gLO + k * 32 + 20] = 1.0
        else
            set gV[gLO + k * 32 + 20] = 0.0
        endif
    endif
    set gV[gLO + k * 32 + 27] = I2R(RT_Buffs(gRTE2) + RT_Buffs(gRTE3))
    set gV[gLO + k * 32 + 29] = 0.0
    if RT_Ok(gRTE2) then
        set gV[gLO + k * 32 + 29] = GetWidgetLife(gRTE2)
    endif
    if RT_Ok(gRTE3) then
        set gV[gLO + k * 32 + 29] = gV[gLO + k * 32 + 29] + GetWidgetLife(gRTE3)
    endif
    set gV[gLO + k * 32 + 28] = 0.0
    if RT_Ok(gRTA1) then
        if GetUnitMoveSpeed(gRTA1) < 0.95 * GetUnitDefaultMoveSpeed(gRTA1) then
            set gV[gLO + k * 32 + 28] = 1.0
        endif
    endif
    if RT_Ok(gRTB) then
        set gV[gLO + k * 32 + 21] = GetWidgetLife(gRTB)
        set gV[gLO + k * 32 + 22] = I2R(BlzGetUnitMaxHP(gRTB))
        set gV[gLO + k * 32 + 23] = I2R(BlzGetUnitMaxMana(gRTB))
        set gV[gLO + k * 32 + 24] = BlzGetUnitArmor(gRTB)
        set gV[gLO + k * 32 + 25] = BlzGetUnitWeaponRealField(gRTB, UNIT_WEAPON_RF_ATTACK_RANGE, 0)
        set gV[gLO + k * 32 + 26] = I2R(BlzGetUnitDiceNumber(gRTB, 0) * 100 + BlzGetUnitBaseDamage(gRTB, 0))
    endif
    set u = null
endfunction

function RT_D takes integer i returns real
    return gV[gLO + 32 + i] - gV[gLO + i]
endfunction

function RT_Has takes integer m, integer bit returns boolean
    return ModuloInteger(m / bit, 2) == 1
endfunction

// ---- diagnosis (test_diagnosis): everything that could explain a FAIL
function RT_UnitInfo takes string tag, unit u returns nothing
    local string s
    if u == null then
        call RT_Log("  " + tag + ": none")
        return
    endif
    set s = "  " + tag + ": " + GetUnitName(u) + " (" + RT_Id(GetUnitTypeId(u)) + ") owner P" + I2S(GetPlayerId(GetOwningPlayer(u)) + 1)
    set s = s + " life " + I2S(R2I(GetWidgetLife(u))) + "/" + I2S(BlzGetUnitMaxHP(u)) + " mana " + I2S(R2I(GetUnitState(u, UNIT_STATE_MANA))) + "/" + I2S(BlzGetUnitMaxMana(u))
    call RT_Log(s)
    set s = "    buffs " + I2S(RT_Buffs(u)) + " dist " + I2S(R2I(SquareRoot((GetUnitX(u) - gRTCX) * (GetUnitX(u) - gRTCX) + (GetUnitY(u) - gRTCY) * (GetUnitY(u) - gRTCY))))
    if IsUnitType(u, UNIT_TYPE_FLYING) then
        set s = s + " air"
    else
        set s = s + " ground"
    endif
    if IsUnitType(u, UNIT_TYPE_STRUCTURE) then
        set s = s + " structure"
    endif
    if IsUnitType(u, UNIT_TYPE_HERO) then
        set s = s + " hero"
    endif
    if IsUnitType(u, UNIT_TYPE_SUMMONED) then
        set s = s + " summoned"
    endif
    if IsUnitType(u, UNIT_TYPE_MECHANICAL) then
        set s = s + " mechanical"
    endif
    if IsUnitType(u, UNIT_TYPE_DEAD) then
        set s = s + " DEAD"
    endif
    if IsUnitAlly(u, gRTP) then
        set s = s + " ally"
    else
        set s = s + " enemy"
    endif
    if IsUnitPaused(u) then
        set s = s + " PAUSED"
    endif
    if IsUnitType(u, UNIT_TYPE_STUNNED) then
        set s = s + " STUNNED"
    endif
    if GetUnitAbilityLevel(u, 'BNsi') > 0 or GetUnitAbilityLevel(u, 'BIsi') > 0 or GetUnitAbilityLevel(u, 'Bsil') > 0 then
        set s = s + " SILENCED"
    endif
    if IsUnitHidden(u) then
        set s = s + " hidden"
    endif
    if IsUnitLoaded(u) then
        set s = s + " loaded"
    endif
    set s = s + " order " + I2S(GetUnitCurrentOrder(u)) + " " + OrderId2String(GetUnitCurrentOrder(u))
    call RT_Log(s)
endfunction

function RT_Diag takes integer i, string why returns nothing
    local integer a = gTAbil[i]
    local string s
    local integer k
    call RT_Log("  DIAG " + why)
    call RT_Log("  ability " + RT_Id(a) + " expected level " + I2S(gTLvl[i]) + " mode " + I2S(gTMode[i]) + " metrics " + I2S(gTMet[i]) + " order '" + gTOrd[i] + "' id " + I2S(OrderId(gTOrd[i])))
    call RT_Log("  IssueOrder returned " + RT_B(gRTIssued) + "; order after issue " + I2S(gRTOrdAfter) + " " + OrderId2String(gRTOrdAfter))
    call RT_Log("  events: SPELL_CHANNEL " + RT_B(gRTEvCh) + " SPELL_CAST " + RT_B(gRTEvCast) + " SPELL_EFFECT " + RT_B(gRTEvEff) + " (the race handler runs on SPELL_EFFECT) FINISH " + RT_B(gRTEvFin) + " ENDCAST " + RT_B(gRTEvEnd))
    if RT_Ok(gRTCaster) and a != 0 then
        call RT_Log("  caster ability level " + I2S(GetUnitAbilityLevel(gRTCaster, a)) + " cooldown left " + R2S(BlzGetUnitAbilityCooldownRemaining(gRTCaster, a)) + " mana cost " + I2S(BlzGetUnitAbilityManaCost(gRTCaster, a, IMaxBJ(0, GetUnitAbilityLevel(gRTCaster, a) - 1))))
        if BlzGetUnitAbility(gRTCaster, a) != null then
            call RT_Log("  cast range " + R2S(BlzGetAbilityRealLevelField(BlzGetUnitAbility(gRTCaster, a), ABILITY_RLF_CAST_RANGE, IMaxBJ(0, GetUnitAbilityLevel(gRTCaster, a) - 1))))
        endif
    endif
    if gTAuto[i] != "" then
        call RT_Log("  autocast: '" + gTAuto[i] + "' issued, return " + RT_B(gRTAutoOk) + "; JASS cannot read the autocast state, judged by an unordered cast event")
    endif
    if gTReq[i] != "" then
        call RT_Log("  tech requirements / related upgrades: " + gTReq[i] + " -> " + RT_ReqState(i))
    endif
    if gTMode[i] == 21 then
        call RT_Log("  RETURN DIAG: no resource arrived. Worker order now " + OrderId2String(GetUnitCurrentOrder(gRTCaster)) + ", hall " + RT_Id(GetUnitTypeId(gRTB)) + " accepts: Argd " + I2S(GetUnitAbilityLevel(gRTB, 'Argd')) + " Argl " + I2S(GetUnitAbilityLevel(gRTB, 'Argl')) + " Arlm " + I2S(GetUnitAbilityLevel(gRTB, 'Arlm')) + " (all 0 = the hall has no return ability: check its uabi), worker-hall distance " + I2S(R2I(SquareRoot((GetUnitX(gRTCaster) - GetUnitX(gRTB)) * (GetUnitX(gRTCaster) - GetUnitX(gRTB)) + (GetUnitY(gRTCaster) - GetUnitY(gRTB)) * (GetUnitY(gRTCaster) - GetUnitY(gRTB))))))
    endif
    call RT_UnitInfo("caster", gRTCaster)
    call RT_UnitInfo("enemy1", gRTE1)
    call RT_UnitInfo("enemy2", gRTE2)
    call RT_UnitInfo("enemy-caster", gRTE3)
    call RT_UnitInfo("invisible enemy", gRTInv)
    call RT_UnitInfo("ally1", gRTA1)
    call RT_UnitInfo("ally2", gRTA2)
    call RT_UnitInfo("probe/building", gRTB)
    set k = 0
    set s = "  before->after:"
    loop
        exitwhen k > 29
        if gV[gLO + k] != gV[gLO + 32 + k] then
            set s = s + " v" + I2S(k) + " " + I2S(R2I(gV[gLO + k])) + "->" + I2S(R2I(gV[gLO + 32 + k]))
        endif
        set k = k + 1
    endloop
    call RT_Log(s)
    call RT_Log("  legend: v0 enemy life, v1 ally life, v2 enemy mana, v3 enemy speed, v4 units, v5 ally armor, v6 enemy armor, v7 enemy buffs, v8 ally buffs, v9 ally mana")
    call RT_Log("  legend: v10 loaded, v11 hidden, v12 gold, v13 lumber, v14/15 caster x/y, v16 caster type, v17 caster max life, v18/19 enemy x/y, v20 invisible seen")
    call RT_Log("  legend: v21-26 probe/building life, max life, max mana, armor, attack range, dice*100+base damage; v27 side-enemy buffs, v28 ally1 slowed, v29 side-enemy life (E2+E3), v30 caster hidden from the enemy")
    call RT_Log("  expected change >= " + R2S(gTNum[i] * RT_TOL) + " (value " + R2S(gTNum[i]) + ", tolerance " + R2S(RT_TOL) + ")")
endfunction

function RT_Eval takes integer i returns integer
    // 1 OK, 2 FAIL, 3 WATCH
    local integer m = gTMet[i]
    local real need = RMaxBJ(1.0, gTNum[i] * RT_TOL)
    local boolean any = false
    local boolean pass = false
    local integer md = gTMode[i]
    local boolean active = md <= 5 or md == 15
    if active and not RT_Has(m, 33554432) and not (gRTEvEff or gRTEvCast) then
        set gRTWhy = "no cast event for the ability"
        return 2
    endif
    if md == 7 and not gRTEvEff then
        set gRTWhy = "autocast did not trigger without a manual order"
        return 2
    endif
    if RT_Has(m, 1) then
        set any = true
        set pass = pass or -RT_D(0) >= need or RT_D(4) < 0
    endif
    if RT_Has(m, 2) then
        set any = true
        set pass = pass or RT_D(1) >= need
    endif
    if RT_Has(m, 4) then
        set any = true
        set pass = pass or -RT_D(2) >= 1.0
    endif
    if RT_Has(m, 8) then
        set any = true
        set pass = pass or -RT_D(3) >= 1.0
    endif
    if RT_Has(m, 16) then
        set any = true
        set pass = pass or RT_D(4) >= 1.0
    endif
    if RT_Has(m, 32) then
        set any = true
        set pass = pass or RT_D(5) >= 0.5
    endif
    if RT_Has(m, 64) then
        set any = true
        set pass = pass or -RT_D(6) >= 0.5
    endif
    if RT_Has(m, 128) then
        set any = true
        set pass = pass or RT_D(16) != 0.0 or RT_D(17) != 0.0
    endif
    if RT_Has(m, 256) then
        set any = true
        set pass = pass or RAbsBJ(RT_D(14)) + RAbsBJ(RT_D(15)) > 100.0
    endif
    if RT_Has(m, 512) then
        set any = true
        set pass = pass or RT_D(7) >= 1.0
    endif
    if RT_Has(m, 1024) then
        set any = true
        set pass = pass or RT_D(8) >= 1.0
    endif
    if RT_Has(m, 2048) then
        set any = true
        set pass = pass or gV[gLO + 32 + 20] > 0.5
    endif
    if RT_Has(m, 4096) then
        set any = true
        set pass = pass or RT_D(9) >= 1.0
    endif
    if RT_Has(m, 8192) then
        set any = true
        set pass = pass or RAbsBJ(RT_D(18)) + RAbsBJ(RT_D(19)) > 60.0
    endif
    if RT_Has(m, 16384) then
        set any = true
        // caster_self_hide: v11 counts OTHER own units only and is a delta; a caster that is invisible from creation (Apiv passive)
        // never changes it (permanent invisibility). v30 = caster hidden from the enemy at the end of the window (it attacked in between).
        set pass = pass or RT_D(11) >= 1.0 or (md == 6 and gV[gLO + 32 + 30] > 0.5)
    endif
    if RT_Has(m, 32768) then
        set any = true
        set pass = pass or RT_D(12) >= 1.0
    endif
    if RT_Has(m, 65536) then
        set any = true
        set pass = pass or RT_D(13) >= 1.0
    endif
    if RT_Has(m, 131072) then
        set any = true
        // orderok_cast: for unit casts (modes 1-5, 15) ORDEROK = order accepted AND the spell effect fired (script-only effects, e.g. a
        // mission well cleanse). gRTFlag alone is only set by the research/building path (a script-only cast test was always FAIL).
        set pass = pass or gRTFlag or (active and gRTIssued and gRTEvEff)
    endif
    if RT_Has(m, 262144) then
        set any = true
        set pass = pass or RT_D(10) >= 1.0
    endif
    if RT_Has(m, 524288) then
        set any = true
        set pass = pass or RT_D(22) > 0.0 or RT_D(23) > 0.0 or RT_D(24) > 0.0 or RT_D(25) > 0.0 or RT_D(26) > 0.0 or RT_D(17) > 0.0   // v17 caster max life: self buffs (e.g. Avatar)
    endif
    if RT_Has(m, 1048576) or RT_Has(m, 16777216) or RT_Has(m, 8388608) or RT_Has(m, 2097152) or RT_Has(m, 4194304) then
        set any = true
        set pass = pass or gRTFlag
    endif
    if RT_Has(m, 134217728) then
        set any = true
        set pass = pass or RT_D(27) >= 1.0
    endif
    if RT_Has(m, 1073741824) then
        // test_runtime: buffs removed from enemies (dispel effects; the test supplies the debuff via hint 'debuff', debuff_test)
        set any = true
        set pass = pass or RT_D(7) <= -1.0
    endif
    if RT_Has(m, 536870912) then
        // test_runtime: damage to the side enemies E2/E3 only (chain/bounce effects), not to the attacked target E1
        set any = true
        set pass = pass or -RT_D(29) >= need
    endif
    if RT_Has(m, 268435456) then
        set any = true
        set pass = pass or gV[gLO + 32 + 28] > 0.5
    endif
    if not any then
        set gRTWhy = "no measurable effect defined: watch it yourself"
        return 3
    endif
    if pass then
        return 1
    endif
    set gRTWhy = "expected change not measured"
    return 2
endfunction


// ===== explicit_facing staging: geometry log + pre-cast assertion =====
function RT_Rel takes unit c, unit u returns real
    local real a = Atan2(GetUnitY(u) - GetUnitY(c), GetUnitX(u) - GetUnitX(c)) * bj_RADTODEG - GetUnitFacing(c)
    loop
        exitwhen a <= 180.0
        set a = a - 360.0
    endloop
    loop
        exitwhen a > -180.0
        set a = a + 360.0
    endloop
    return a
endfunction

function RT_Dist takes unit a, unit b returns real
    return SquareRoot((GetUnitX(a) - GetUnitX(b)) * (GetUnitX(a) - GetUnitX(b)) + (GetUnitY(a) - GetUnitY(b)) * (GetUnitY(a) - GetUnitY(b)))
endfunction

function RT_GeoLog takes string n, unit u returns nothing
    if RT_Ok(u) and RT_Ok(gRTCaster) and u != gRTCaster then
        call RT_Log("  STAGE " + n + " " + RT_Id(GetUnitTypeId(u)) + " at (" + I2S(R2I(GetUnitX(u))) + "," + I2S(R2I(GetUnitY(u))) + ") dist " + I2S(R2I(RT_Dist(gRTCaster, u))) + " angle-to-facing " + I2S(R2I(RT_Rel(gRTCaster, u))))
    endif
endfunction

function RT_GeoOk takes integer i, unit u, boolean ctl returns boolean
    local real a
    local real d
    local real want = gTGRel[i]
    if not RT_Ok(u) then
        set gRTWhy = "FAIL-SETUP: target unit missing"
        return false
    endif
    set a = RT_Rel(gRTCaster, u)
    set d = RT_Dist(gRTCaster, u)
    if ctl then
        set want = want + 180.0
        if want > 180.0 then
            set want = want - 360.0
        endif
    endif
    if RT_Has(gTGeo[i], 4) and RAbsBJ(ModuloReal(a - want + 540.0, 360.0) - 180.0) > gTGTol[i] then
        set gRTWhy = "FAIL-SETUP: " + RT_Id(GetUnitTypeId(u)) + " at angle " + I2S(R2I(a)) + " to the facing, needed " + I2S(R2I(want)) + " +-" + I2S(R2I(gTGTol[i]))
        return false
    endif
    if RT_Has(gTGeo[i], 8) and not ctl and (d < gTGDmin[i] or d > gTGDmax[i]) then
        set gRTWhy = "FAIL-SETUP: " + RT_Id(GetUnitTypeId(u)) + " at distance " + I2S(R2I(d)) + ", needed " + I2S(R2I(gTGDmin[i])) + "-" + I2S(R2I(gTGDmax[i]))
        return false
    endif
    return true
endfunction

// clean_target_dummies pre-check: every stock dummy must be ability-free before the cast, otherwise FAIL-SETUP
function RT_DummyOk takes unit u returns boolean
    local integer n
    if u == null or not IsUnitInGroup(u, gRTDummy) then
        return true
    endif
    // current_ability_level: abilities can be added after creation (race auras/zones); strip again right before the cast, log leftovers
    set n = RT_Extra(u, true)
    if n > 0 then
        call RT_Log("  DIAG dummy " + RT_Id(GetUnitTypeId(u)) + " keeps " + I2S(n) + " non-removable abilities: " + RT_AbilList(u))
        set gRTWhy = "FAIL-SETUP: dummy " + RT_Id(GetUnitTypeId(u)) + " still has " + I2S(n) + " own abilities (clean_target_dummies)"
        return false
    endif
    return true
endfunction

// returns false -> FAIL-SETUP (staging wrong, the ability was NOT judged)
function RT_Stage takes integer i, string when returns boolean
    if gTMode[i] == 17 or gTMode[i] == 18 then
        return true
    endif
    if not RT_Ok(gRTCaster) then
        return true
    endif
    call RT_Log("  STAGE " + when + ": caster " + RT_Id(GetUnitTypeId(gRTCaster)) + " at (" + I2S(R2I(GetUnitX(gRTCaster))) + "," + I2S(R2I(GetUnitY(gRTCaster))) + ") facing " + I2S(R2I(GetUnitFacing(gRTCaster))) + " (wanted " + I2S(R2I(gRTFaceWant)) + ")")
    call RT_GeoLog("E1", gRTE1)
    call RT_GeoLog("E2", gRTE2)
    call RT_GeoLog("E3", gRTE3)
    call RT_GeoLog("A1", gRTA1)
    call RT_GeoLog("A2", gRTA2)
    if not (RT_DummyOk(gRTE1) and RT_DummyOk(gRTE2) and RT_DummyOk(gRTE3) and RT_DummyOk(gRTA1) and RT_DummyOk(gRTA2) and RT_DummyOk(gRTInv) and RT_DummyOk(gRTSum)) then
        return false
    endif
    call RT_Log("  DIAG dummies ability-free: yes")
    if gTDebuff[i] == 1 then
        call RT_Log("  DIAG debuff on E1 (Slow) present: " + RT_B(GetUnitAbilityLevel(gRTE1, 'Bslo') > 0))
    elseif gTDebuff[i] == 2 then
        call RT_Log("  DIAG debuff on A1 (Slow) present: " + RT_B(GetUnitAbilityLevel(gRTA1, 'Bslo') > 0))
    endif
    if not IsUnitType(gRTCaster, UNIT_TYPE_STRUCTURE) and RAbsBJ(ModuloReal(GetUnitFacing(gRTCaster) - gRTFaceWant + 540.0, 360.0) - 180.0) > 20.0 and (RT_Has(gTGeo[i], 1) or RT_Has(gTGeo[i], 4)) then
        set gRTWhy = "FAIL-SETUP: caster faces " + I2S(R2I(GetUnitFacing(gRTCaster))) + ", wanted " + I2S(R2I(gRTFaceWant))
        return false
    endif
    if RT_Has(gTGeo[i], 4) or RT_Has(gTGeo[i], 8) then
        if not RT_GeoOk(i, gRTE1, false) then
            return false
        endif
        if gTECtl[i] == 1 then
            if not RT_GeoOk(i, gRTE3, true) then
                return false
            endif
        elseif not RT_GeoOk(i, gRTE2, false) or not RT_GeoOk(i, gRTE3, false) then
            return false
        endif
    endif
    return true
endfunction

function RT_OnDamage takes nothing returns nothing
    local unit s = GetEventDamageSource()
    if gStage == 2 and s != null and s != gRTCaster and IsUnitInGroup(s, gRTAll) and not IsUnitInGroup(s, gRTAct) and GetEventDamage() > 0.0 then
        call RT_Log("  CONTAMINATED: unexpected damage " + R2S(GetEventDamage()) + " from " + RT_Id(GetUnitTypeId(s)) + " to " + RT_Id(GetUnitTypeId(GetTriggerUnit())) + " (blocked)")
        call BlzSetEventDamage(0.0)
        set gRTContam = true
    endif
    set s = null
endfunction

function RT_OnStrayCast takes nothing returns nothing
    local unit s = GetTriggerUnit()
    if gStage >= 1 and gStage <= 2 and s != gRTCaster and IsUnitInGroup(s, gRTAll) and not IsUnitInGroup(s, gRTAct) then
        call RT_Log("  CONTAMINATED: unexpected spell " + RT_Id(GetSpellAbilityId()) + " by " + RT_Id(GetUnitTypeId(s)) + " (stopped)")
        call IssueImmediateOrder(s, "stop")
        set gRTContam = true
    endif
    set s = null
endfunction

// ===== selectability selectability check (parallel_lanes: selection is always enabled; only one lane at a time runs a selection test) =====

// condition_test: building ON a gold mine (Haunted-Gold-Mine style) is always a real build order of a
// computer-owned worker on the mine's exact position. Every wait has a hard timeout -> FAIL with a reason, never a hang.
function RT_MineOrder takes unit w, integer id, unit mine returns boolean
    local real x = gRTX + 350.0
    local real y = gRTY
    local boolean ok
    if mine != null then
        set x = GetUnitX(mine)
        set y = GetUnitY(mine)
    endif
    set gRTMineSt = 0
    set gRTMineT0 = gRTAge
    set gRTMineWhy = ""
    call SetPlayerState(GetOwningPlayer(w), PLAYER_STATE_RESOURCE_GOLD, IMaxBJ(GetPlayerState(GetOwningPlayer(w), PLAYER_STATE_RESOURCE_GOLD), 100000))
    call SetPlayerState(GetOwningPlayer(w), PLAYER_STATE_RESOURCE_LUMBER, IMaxBJ(GetPlayerState(GetOwningPlayer(w), PLAYER_STATE_RESOURCE_LUMBER), 100000))
    set ok = IssueBuildOrderById(RT_Act(w), id, x, y)
    call RT_Log("  BUILD order " + RT_Id(id) + " by " + RT_Id(GetUnitTypeId(w)) + " (owner " + I2S(GetPlayerId(GetOwningPlayer(w))) + ", gold " + I2S(GetPlayerState(GetOwningPlayer(w), PLAYER_STATE_RESOURCE_GOLD)) + ") at " + R2S(x) + "/" + R2S(y) + ", on mine " + RT_B(mine != null) + ": accepted=" + RT_B(ok) + ", worker order now " + I2S(GetUnitCurrentOrder(w)))
    if not ok and mine != null then
        // current_ability_level: build-on structures (haunted-mine type) can also be ordered with the mine as the order TARGET
        set ok = IssueTargetOrderById(w, id, mine)
        call RT_Log("  BUILD retry as target order on the mine: accepted=" + RT_B(ok))
    endif
    if not ok and mine != null then
        // current_ability_level: a freshly created mine may not accept a build-on order in the same moment -> retry (RT_MineWatch, max RT_BUILDSTART)
        set gRTMineSt = -2
        set gRTMineWhy = "build order refused (on the mine: point order and target order, retried for " + R2S(RT_BUILDSTART) + " s)"
        set gRTMineU = mine
        return true
    endif
    if not ok then
        set gRTMineSt = -1
        set gRTMineWhy = "build order refused"
    endif
    return ok
endfunction

// 0 waiting, 1 construction started (once), 2 finished, -1 failed (gRTMineWhy). force: complete the started building at once
function RT_MineWatch takes boolean force returns integer
    if gRTMineSt == -2 then
        if IssueBuildOrderById(gRTCaster, gTAbil[gCur], GetUnitX(gRTMineU), GetUnitY(gRTMineU)) or IssueTargetOrderById(gRTCaster, gTAbil[gCur], gRTMineU) then
            call RT_Log("  BUILD order accepted on retry after " + R2S(gRTAge - gRTMineT0) + " s")
            set gRTMineSt = 0
            set gRTMineWhy = ""
            set gRTMineT0 = gRTAge
            return 0
        elseif gRTAge - gRTMineT0 > RT_BUILDSTART then
            set gRTMineSt = -1
            call RT_Log("  BUILD FAIL: " + gRTMineWhy)
            return -1
        endif
        return 0
    endif
    if gRTMineSt < 0 or gRTMineSt >= 2 then
        return gRTMineSt
    endif
    if gRTMineSt == 0 then
        if gRTCon != null then
            set gRTMineSt = 1
            set gRTMineT0 = gRTAge
            call RT_Log("  BUILD construction started: " + RT_Id(GetUnitTypeId(gRTCon)) + " at " + R2S(GetUnitX(gRTCon)) + "/" + R2S(GetUnitY(gRTCon)) + " after " + R2S(gRTAge - RT_ANNOUNCE) + " s")
            if force then
                call UnitSetConstructionProgress(gRTCon, 100)
            endif
            return 1
        elseif gRTAge - gRTMineT0 > RT_BUILDSTART then
            set gRTMineSt = -1
            set gRTMineWhy = "construction did not start within " + R2S(RT_BUILDSTART) + " s (worker order now " + I2S(GetUnitCurrentOrder(gRTCaster)) + ")"
            call RT_Log("  BUILD FAIL: " + gRTMineWhy)
            return -1
        endif
        return 0
    endif
    if gRTFin != null then
        set gRTMineSt = 2
        call RT_Log("  BUILD construction finished: " + RT_Id(GetUnitTypeId(gRTFin)) + " after " + R2S(gRTAge - gRTMineT0) + " s")
        return 2
    elseif gRTAge - gRTMineT0 > RT_BUILDDONE then
        set gRTMineSt = -1
        set gRTMineWhy = "construction started but did not finish within " + R2S(RT_BUILDDONE) + " s"
        call RT_Log("  BUILD FAIL: " + gRTMineWhy)
        return -1
    endif
    return 1
endfunction

// test_timing: the observer's selection is one global resource; a lane holds it only for RT_SELWAIT (lock gSelLock)
function RT_SelBegin takes unit u returns boolean
    if gSelLock >= 0 and gSelLock != gAct then
        return false
    endif
    set gSelLock = gAct
    if GetLocalPlayer() == Player(0) then
        call EnableSelect(true, true)
    endif
    call ClearSelectionForPlayer(Player(0))
    call SelectUnitForPlayerSingle(u, Player(0))
    return true
endfunction

function RT_SelInfo takes unit u returns string
    local string s = RT_Id(GetUnitTypeId(u)) + " Aloc=" + I2S(GetUnitAbilityLevel(u, 'Aloc')) + " engineSelectable=" + RT_B(BlzIsUnitSelectable(u)) + " hidden=" + RT_B(IsUnitHidden(u)) + " paused=" + RT_B(IsUnitPaused(u))
    set s = s + " structure=" + RT_B(IsUnitType(u, UNIT_TYPE_STRUCTURE)) + " hero=" + RT_B(IsUnitType(u, UNIT_TYPE_HERO)) + " summoned=" + RT_B(IsUnitType(u, UNIT_TYPE_SUMMONED)) + " flying=" + RT_B(IsUnitType(u, UNIT_TYPE_FLYING))
    set s = s + " selScale=" + R2S(BlzGetUnitRealField(u, UNIT_RF_SELECTION_SCALE)) + " modelScale=" + R2S(BlzGetUnitRealField(u, UNIT_RF_SCALING_VALUE)) + " life=" + I2S(R2I(GetWidgetLife(u)))
    return s
endfunction

// returns true when selectable; on FAIL gRTWhy lists cause candidates
// real_clicks: ask the observer for a real click (only in '-repeat' runs); RT_ClickWait: 0 waiting, 1 clicked, 2 timeout
function RT_ClickAsk takes unit u returns nothing
    set gRTClickU = u
    set gRTClickOn = true
    set gRTClicked = false
    set gRTClickAt = gRTAge
    call PanCameraToTimedForPlayer(Player(0), GetUnitX(u), GetUnitY(u), 0.5)
    call RT_Say("|cffffcc00Lane " + I2S(gAct + 1) + ": CLICK " + GetUnitName(u) + " NOW|r (left-click it within " + I2S(R2I(RT_CLICKWAIT)) + " s; this proves it is clickable)", RT_CLICKWAIT)
    call PingMinimap(GetUnitX(u), GetUnitY(u), 3.0)
    call RT_Log("  CLICK request: " + RT_Id(GetUnitTypeId(u)) + " (waiting for a real click)")
endfunction

function RT_ClickWait takes nothing returns integer
    if gRTClicked then
        set gRTClickOn = false
        call RT_Log("  CLICK proof: the player selected " + RT_Id(GetUnitTypeId(gRTClickU)) + " after " + R2S(gRTAge - gRTClickAt) + " s")
        return 1
    elseif gRTAge - gRTClickAt > RT_CLICKWAIT then
        set gRTClickOn = false
        call RT_Log("  CLICK timeout: no real click on " + RT_Id(GetUnitTypeId(gRTClickU)))
        return 2
    endif
    return 0
endfunction

// lane_players: Player 0's selection is ONE map-wide state; a selection set in the same tick as an engine selection refresh
// (construction start, upgrade finish) or a real observer click can be dropped -> re-select once before judging
function RT_SelRetry takes unit u returns boolean
    if IsUnitSelected(u, Player(0)) or not BlzIsUnitSelectable(u) or gRTSelTry >= 1 then
        return false
    endif
    set gRTSelTry = gRTSelTry + 1
    call RT_Log("  SELECT retry: " + RT_Id(GetUnitTypeId(u)) + " was not selected after " + R2S(RT_SELWAIT) + " s -> selecting again")
    call ClearSelectionForPlayer(Player(0))
    call SelectUnitForPlayerSingle(u, Player(0))
    set gRTSelAt = gRTAge
    return true
endfunction

function RT_SelEnd takes unit u, string what returns boolean
    local boolean sel = IsUnitSelected(u, Player(0))
    local boolean eng = BlzIsUnitSelectable(u)
    local boolean hit = BlzGetUnitRealField(u, UNIT_RF_SELECTION_SCALE) > 0.0 and (BlzGetUnitCollisionSize(u) > 0.0 or IsUnitType(u, UNIT_TYPE_STRUCTURE))
    local boolean mdl = RT_ModelOk(GetUnitTypeId(u))
    local string c = ""
    call RT_Log("  SELECT " + what + ": selected=" + RT_B(sel) + " | " + RT_SelInfo(u) + " collision=" + R2S(BlzGetUnitCollisionSize(u)) + " modelFileExists=" + RT_B(mdl))
    // parallel_lanes: selection stays enabled afterwards (the observer may click units); only the check selection is cleared
    call ClearSelectionForPlayer(Player(0))
    if gSelLock == gAct then
        set gSelLock = -1
    endif
    if sel and eng and hit and mdl and GetUnitAbilityLevel(u, 'Aloc') == 0 then
        return true
    endif
    if not mdl then
        set c = c + "model file does not exist in the game data (no model = no hit box, players cannot click it); "
    endif
    if not hit then
        set c = c + "no selection scale or hit/collision radius; "
    endif
    if GetUnitAbilityLevel(u, 'Aloc') > 0 then
        set c = c + "has Locust (Aloc); "
    endif
    if IsUnitHidden(u) then
        set c = c + "unit hidden; "
    endif
    if BlzGetUnitRealField(u, UNIT_RF_SELECTION_SCALE) <= 0.0 then
        set c = c + "selection scale 0 (no selection circle); "
    endif
    if IsUnitType(u, UNIT_TYPE_STRUCTURE) and GetWidgetLife(u) < 1.0 then
        set c = c + "building not initialised (life 0); "
    endif
    if IsUnitType(u, UNIT_TYPE_SUMMONED) then
        set c = c + "dummy/ward-like summoned flag; "
    endif
    if not eng and c == "" then
        set c = "engine reports not selectable (check uabi for Aloc/ward classification, model, ussc)"
    elseif eng and not sel then
        set c = c + "engine selectable but the script selection did not stick (classification ward? model without selection data?)"
    endif
    set gRTWhy = what + " NOT selectable: " + c
    return false
endfunction
